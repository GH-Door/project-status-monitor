# 실제 키로 교체할 것 — 아래 값은 전부 가상 키
OPENAI_API_KEY=sk-REPLACE_ME
# 로컬 Dify의 Dataset API 주소와 키(지식베이스 읽기·쓰기). 로컬 uv 실행에 쓰인다
DIFY_API_BASE=http://localhost/v1
DIFY_DATASET_API_KEY=dataset-REPLACE_ME
# Docker 실행 시 컨테이너가 호스트의 Dify에 붙는 주소(비우면 http://host.docker.internal/v1)
# DIFY_API_BASE_DOCKER=http://host.docker.internal/v1
# 허용할 접속 호스트명(콤마 구분). 기본 localhost,127.0.0.1,testserver. 다른 이름으로 접속하면 거부된다
# ALLOWED_HOSTS=localhost,127.0.0.1

# 답변·이미지 판독·질문 재작성·지표 추출에 쓰는 모델(전부 temperature 0)
ANSWER_MODEL=gpt-4.1-mini
# (아직 쓰이지 않음) 모델 비교 실험용으로 예약
COMPARE_MODEL=gpt-4.1

# 남은 4주 운영 한도(원) — 기획서 §10
BUDGET_LIMIT_KRW=300000

# sqlite 파일 경로
DB_PATH=data/app.db
DATA_DIR=data

# 이 도구를 쓰는 회사 이름. 비우면 문서 폴더에 하위 폴더가 하나일 때 그 이름, 아니면 '우리 회사'. 화면에서도 바꿀 수 있다.
COMPANY_NAME=
# 이 폴더(하위 폴더 포함)의 md 문서가 그 회사의 문서 DB다. 정답·answer·gold 이름의 파일은 제외된다.
# RAG_DOCS_DIR=data/RAG_문서
